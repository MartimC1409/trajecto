# Copia este ficheiro para ".env.local" se quiseres mudar algum valor.
# Nunca coloques segredos aqui: as variáveis VITE_* ficam visíveis no browser.

# Servidor Photon para onde o proxy local reencaminha as pesquisas.
# Exemplo com uma instância própria: GEOCODER_UPSTREAM=http://localhost:2322
GEOCODER_UPSTREAM=https://photon.komoot.io

# URL usado pelo browser para pesquisar (normalmente o proxy local).
VITE_GEOCODER_URL=/geocoder

# Tiles vetoriais (esquema OpenMapTiles) e fontes.
VITE_MAP_TILEJSON_URL=https://tiles.openfreemap.org/planet
VITE_MAP_GLYPHS_URL=https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf
